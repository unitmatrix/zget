prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: libzget
Description: Stream one member from a remote ZIP archive
Version: @PROJECT_VERSION@
Requires.private: libcurl >= 7.85.0, zlib
Libs: -L${libdir} -lzget
Cflags: -I${includedir}
